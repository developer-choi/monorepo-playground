{
  "name": "@developer-choi/utils",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developer-choi/monorepo-playground.git",
    "directory": "packages/utils"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
